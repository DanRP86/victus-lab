type EventStatus = 'completed' | 'planned' | 'constraint';

interface CalendarEvent {
    id: string;
    title: string;
    subtitle?: string;
    category: Category;
    status: EventStatus;
    time: string;
    durationMin: number;
    // Exposure 0 to 3
