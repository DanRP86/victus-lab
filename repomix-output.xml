        grip: 0 | 1 | 2 | 3;
        pull: 0 | 1 | 2 | 3;
        push: 0 | 1 | 2 | 3;
        shoulder: 0 | 1 | 2 | 3;
        core: 0 | 1 | 2 | 3;
    };
    notes?: string;
    constraintRationale?: string;
}

interface NutritionSummary {
    caloricDelta: number; // e.g. +450 or -200
    freshScorePct: number;
    ratioNaK: number;
    socialExposure?: string;
}

