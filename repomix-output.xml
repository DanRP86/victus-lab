                                                                    }`}
                                                            />
                                                        ))}
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>

                                    {/* Nutritional Consequence */}
                                    <div className="space-y-3 border-t border-white/[0.06] pt-6">
                                        <span className="font-mono text-[10px] uppercase tracking-wider text-[#626D7C]">
                                            Nutritional Correlation
