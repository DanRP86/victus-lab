                                                        )}
                                                    </motion.div>
                                                );
                                            })}
                                        </div>
                                    </div>

                                    {/* --- BOTTOM: MUSCLE STRAIN & NUTRITION TELEMETRY --- */}
                                    <div className="border-t border-white/[0.05] pt-3.5 mt-4 space-y-3">
                                        {/* Muscle Load Vector Strip */}
