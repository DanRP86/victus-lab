                            {/* Stroke line */}
                            <path
                                d="M 0 80 L 50 30 L 150 55 L 250 50 L 350 25 L 450 10 L 550 15 L 650 65 L 700 80"
                                fill="none"
                                stroke="#4FE3C1"
