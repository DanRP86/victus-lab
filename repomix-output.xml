                                    onClick={onToggleDessert}
                                    className={`flex flex-1 items-center justify-center gap-2 rounded-lg border py-2 text-xs font-medium transition-all ${hasDessert
                                            ? 'border-amber-500/40 bg-amber-500/10 text-[#F59E0B]'
