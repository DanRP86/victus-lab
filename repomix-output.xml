<file path="src/app/page.tsx">
'use client';

import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
  CalendarDays,
  Flame,
  Dumbbell,
  Plus,
  X,
  ChevronRight,
  Filter
} from 'lucide-react';

// --- TIPOGRAFÍAS RECOMENDADAS ---
// font-serif: 'Ogg', 'PP Editorial New' o 'Playfair Display'
// font-sans: 'PP Neue Montreal', 'Inter'
// font-mono: 'Geist Mono', 'JetBrains Mono'

type ViewState = 'calendar' | 'meals' | 'sports';

// Datos de prueba ampliados para las nuevas vistas
const DAYS_DATA = [
  { id: 'd1', day: 'MON', date: '14', strain: 72, focus: 'High Pull', hasMeal: true },
  { id: 'd2', day: 'TUE', date: '15', strain: 40, focus: 'Antagonist', hasMeal: true },
  { id: 'd3', day: 'WED', date: '16', strain: 35, focus: 'Aerobic Base', hasMeal: false },
  { id: 'd4', day: 'THU', date: '17', strain: 68, focus: 'Posterior', hasMeal: false },
  { id: 'd5', day: 'FRI', date: '18', strain: 95, focus: 'Peak Demand', hasMeal: true, isToday: true },
  { id: 'd6', day: 'SAT', date: '19', strain: 88, focus: 'Outdoor Rock', hasMeal: false },
  { id: 'd7', day: 'SUN', date: '20', strain: 20, focus: 'Restoration', hasMeal: false },
];

const MEALS_DB = [
  { id: 'm1', name: 'Tonkotsu Ramen', type: 'Slow Cooked', kcal: 850, tags: ['High Na', 'Liquid'] },
  { id: 'm2', name: 'Grilled Salmon Bowl', type: 'Raw / Sear', kcal: 620, tags: ['Omega 3', 'Fresh'] },
  { id: 'm3', name: 'Lentil Stew', type: 'Slow Cooked', kcal: 540, tags: ['Plant Based', 'Iron'] },
  { id: 'm4', name: 'Smashed Burger', type: 'Fast / Grill', kcal: 920, tags: ['Heavy', 'Cheat'] },
];

const SPORTS_DB = [
  { id: 's1', name: 'Bouldering', category: 'Climb', impact: 'High', energy: 'Anaerobic' },
  { id: 's2', name: 'Wingfoil', category: 'Wind', impact: 'Medium', energy: 'Hybrid' },
  { id: 's3', name: 'Zone 2 Run', category: 'Aero', impact: 'High', energy: 'Aerobic' },
  { id: 's4', name: 'Mobility Flow', category: 'Rest', impact: 'Low', energy: 'Recovery' },
];

const customEase = [0.16, 1, 0.3, 1];

export default function AwwwardsNutritionApp() {
  const [activeView, setActiveView] = useState<ViewState>('calendar');
  const [expandedDayId, setExpandedDayId] = useState<string | null>(null);
  const [isQuickLogOpen, setIsQuickLogOpen] = useState(false);
  const [activeMealFilter, setActiveMealFilter] = useState('All');

  // --- SUBCOMPONENTES DE LAS VISTAS ---

  const CalendarView = () => (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      exit={{ opacity: 0 }}
      className="w-full h-full pt-32 pb-24 px-8 md:px-24 flex flex-col justify-center"
    >
      <div className="mb-12">
        <h1 className="font-serif text-6xl md:text-8xl font-light tracking-tighter text-white leading-[0.9]">
          September <br /><span className="text-[#4FE3C1] italic">Timeline.</span>
        </h1>
        <p className="font-mono text-xs uppercase tracking-[0.3em] text-[#555] mt-6">
          Infinite Horizon · Drag to explore
        </p>
      </div>

      {/* Carrusel Horizontal Físico (Tarjetas con Profundidad) */}
      <div className="flex gap-6 overflow-x-auto pb-12 pt-4 snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden w-full items-center">
        {DAYS_DATA.map((day) => (
          <motion.div
            layoutId={`day-card-${day.id}`}
            key={day.id}
            onClick={() => setExpandedDayId(day.id)}
            className={`relative min-w-[280px] h-[400px] snap-center cursor-pointer group flex flex-col justify-between p-8 rounded-3xl border transition-colors duration-500 overflow-hidden
              ${day.isToday
                ? 'bg-[#111] border-[#4FE3C1]/30 hover:border-[#4FE3C1]'
                : 'bg-white/[0.02] border-white/[0.05] hover:bg-white/[0.04] hover:border-white/[0.2]'
              }`}
          >
            {/* Efecto de luz interior */}
            <div className="absolute inset-0 bg-gradient-to-b from-white/[0.05] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none" />

            <div>
              <motion.span layoutId={`day-name-${day.id}`} className="font-mono text-[10px] uppercase tracking-[0.3em] text-[#666] group-hover:text-white transition-colors">
                {day.day}
              </motion.span>
              <motion.h2 layoutId={`day-date-${day.id}`} className="font-serif text-7xl font-light text-white tracking-tighter mt-2">
                {day.date}
              </motion.h2>
            </div>

            <div className="relative z-10">
              <div className="h-[1px] w-full bg-white/10 mb-4 group-hover:w-full transition-all duration-700" />
              <p className="font-sans text-sm text-[#ccc] mb-2">{day.focus}</p>
              <div className="flex items-center gap-4 font-mono text-[9px] uppercase tracking-widest text-[#555]">
                <span>Load {day.strain}%</span>
                {day.hasMeal && <span className="text-[#F59E0B] flex items-center gap-1"><Flame size={10} /> Fueled</span>}
              </div>
            </div>
          </motion.div>
        ))}
      </div>
    </motion.div>
  );

  const MealsView = () => (
    <motion.div
      initial={{ opacity: 0, y: 40 }}
      animate={{ opacity: 1, y: 0 }}
      exit={{ opacity: 0, y: -40 }}
      transition={{ duration: 0.8, ease: customEase }}
      className="w-full h-full pt-32 pb-24 px-8 md:px-24"
    >
      <div className="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
        <div>
          <h1 className="font-serif text-6xl md:text-8xl font-light tracking-tighter text-white">
            Nutrition <span className="text-[#F59E0B] italic">Lab.</span>
          </h1>
          <p className="font-mono text-xs uppercase tracking-[0.3em] text-[#555] mt-6">
            Archetype Database
          </p>
        </div>

        {/* Filtros Estilo Awwwards */}
        <div className="flex gap-2">
          {['All', 'Raw / Sear', 'Slow Cooked', 'Fast / Grill'].map(filter => (
            <button
              key={filter}
              onClick={() => setActiveMealFilter(filter)}
              className={`px-4 py-2 rounded-full font-mono text-[10px] uppercase tracking-wider border transition-all duration-300
                ${activeMealFilter === filter ? 'bg-white text-black border-white' : 'bg-transparent text-[#666] border-[#333] hover:border-white hover:text-white'}`}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {MEALS_DB.filter(m => activeMealFilter === 'All' || m.type === activeMealFilter).map((meal, idx) => (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: idx * 0.1 }}
            key={meal.id}
            className="group relative h-[300px] rounded-3xl bg-[#0a0a0a] border border-white/[0.05] p-8 flex flex-col justify-between overflow-hidden cursor-pointer hover:border-white/[0.2] transition-colors"
          >
            {/* Imagen de fondo simulada con gradiente */}
            <div className="absolute inset-0 bg-gradient-to-br from-[#111] to-[#050505] opacity-50 group-hover:scale-105 transition-transform duration-1000" />

            <div className="relative z-10 flex justify-between items-start">
              <span className="px-3 py-1 rounded-full border border-white/10 text-[9px] font-mono uppercase tracking-widest text-[#888] backdrop-blur-sm">
                {meal.type}
              </span>
              <span className="font-serif text-2xl text-white">{meal.kcal} <span className="text-sm text-[#555] font-sans">kcal</span></span>
            </div>

            <div className="relative z-10">
              <h3 className="font-sans text-2xl text-white font-medium mb-3 group-hover:text-[#F59E0B] transition-colors">{meal.name}</h3>
              <div className="flex gap-2">
                {meal.tags.map(tag => (
                  <span key={tag} className="font-mono text-[9px] text-[#555] uppercase tracking-wider before:content-['#']">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </motion.div>
        ))}
      </div>
    </motion.div>
  );

  const SportsView = () => (
    <motion.div
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      exit={{ opacity: 0 }}
      transition={{ duration: 0.8, ease: customEase }}
      className="w-full h-full pt-32 pb-24 px-8 md:px-24"
    >
      <h1 className="font-serif text-6xl md:text-8xl font-light tracking-tighter text-white mb-16">
        Training <span className="text-[#38BDF8] italic">Grounds.</span>
      </h1>

      <div className="grid grid-cols-1 border-t border-white/10">
        {SPORTS_DB.map((sport, idx) => (
          <div key={sport.id} className="group border-b border-white/10 py-8 flex flex-col md:flex-row md:items-center justify-between cursor-pointer hover:bg-white/[0.02] px-4 -mx-4 transition-colors duration-300">
            <div className="flex items-center gap-12">
              <span className="font-mono text-sm text-[#444]">0{idx + 1}</span>
              <h2 className="font-serif text-4xl md:text-5xl text-white group-hover:translate-x-4 transition-transform duration-500">{sport.name}</h2>
            </div>
            <div className="flex items-center gap-12 mt-6 md:mt-0 font-mono text-[10px] uppercase tracking-[0.2em] text-[#666]">
              <span className="w-24">{sport.category}</span>
              <span className="w-24">Impact: {sport.impact}</span>
              <span className="w-24 text-[#38BDF8] opacity-0 group-hover:opacity-100 transition-opacity">Launch ↗</span>
            </div>
          </div>
        ))}
      </div>
    </motion.div>
  );

  return (
    <div className="relative min-h-screen w-full bg-[#030303] text-[#EAEAEA] overflow-hidden selection:bg-white selection:text-black">

      {/* --- NAVEGACIÓN FLOTANTE (ESTILO AGENCIA AWWWARDS) --- */}
      <nav className="fixed top-8 left-1/2 -translate-x-1/2 z-50 flex items-center bg-white/[0.03] backdrop-blur-xl border border-white/[0.05] rounded-full p-2 gap-2 shadow-2xl">
        {[
          { id: 'calendar', icon: CalendarDays, label: 'Timeline' },
          { id: 'meals', icon: Flame, label: 'Nutrition' },
          { id: 'sports', icon: Dumbbell, label: 'Training' }
        ].map((item) => (
          <button
            key={item.id}
            onClick={() => setActiveView(item.id as ViewState)}
            className={`relative flex items-center gap-2 px-5 py-2.5 rounded-full font-mono text-[10px] uppercase tracking-widest transition-all duration-500 overflow-hidden
              ${activeView === item.id ? 'text-black' : 'text-[#888] hover:text-white'}`}
          >
            {activeView === item.id && (
              <motion.div
                layoutId="nav-pill"
                className="absolute inset-0 bg-white rounded-full z-0"
                transition={{ type: 'spring', stiffness: 400, damping: 30 }}
              />
            )}
            <item.icon size={14} className="relative z-10" />
            <span className="relative z-10">{item.label}</span>
          </button>
        ))}
      </nav>

      {/* --- CONTENIDO PRINCIPAL --- */}
      <main className="relative w-full h-screen overflow-y-auto [scrollbar-width:none]">
        <AnimatePresence mode="wait">
          {activeView === 'calendar' && <CalendarView key="calendar" />}
          {activeView === 'meals' && <MealsView key="meals" />}
          {activeView === 'sports' && <SportsView key="sports" />}
        </AnimatePresence>
      </main>

      {/* --- BOTÓN DE ACCIÓN RÁPIDA (FAB MAGNETICO) --- */}
      <motion.button
        whileHover={{ scale: 1.05 }}
        whileTap={{ scale: 0.95 }}
        onClick={() => setIsQuickLogOpen(true)}
        className="fixed bottom-12 right-12 z-40 w-16 h-16 bg-[#4FE3C1] text-black rounded-full flex items-center justify-center shadow-[0_0_40px_rgba(79,227,193,0.3)] hover:shadow-[0_0_60px_rgba(79,227,193,0.5)] transition-shadow"
      >
        <Plus size={24} />
      </motion.button>

      {/* --- OVERLAY DE DÍA EXPANDIDO (SHARED LAYOUT ANIMATION) --- */}
      <AnimatePresence>
        {expandedDayId && (
          <>
            {/* Fondo oscuro al abrir el día */}
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              className="fixed inset-0 bg-black/80 backdrop-blur-md z-50"
              onClick={() => setExpandedDayId(null)}
            />

            {/* Tarjeta Expandida */}
            <div className="fixed inset-0 z-50 flex items-center justify-center pointer-events-none p-4 md:p-12">
              <motion.div
                layoutId={`day-card-${expandedDayId}`}
                className="w-full max-w-5xl h-[80vh] bg-[#0a0a0a] border border-white/10 rounded-[40px] pointer-events-auto flex flex-col md:flex-row overflow-hidden shadow-2xl"
              >
                {/* Panel Izquierdo: Info del Día */}
                <div className="w-full md:w-1/3 bg-[#111] p-12 flex flex-col justify-between border-r border-white/5">
                  <div>
                    <motion.span layoutId={`day-name-${expandedDayId}`} className="font-mono text-xs uppercase tracking-[0.4em] text-[#4FE3C1]">
                      {DAYS_DATA.find(d => d.id === expandedDayId)?.day}
                    </motion.span>
                    <motion.h2 layoutId={`day-date-${expandedDayId}`} className="font-serif text-8xl font-light text-white tracking-tighter mt-4">
                      {DAYS_DATA.find(d => d.id === expandedDayId)?.date}
                    </motion.h2>
                    <p className="mt-8 font-sans text-[#888] leading-relaxed">
                      Detailed telemetry and event mapping for this cycle. Active restoration and low-impact protocols engaged.
                    </p>
                  </div>
                  <button onClick={() => setExpandedDayId(null)} className="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-[#666] hover:text-white transition-colors">
                    <X size={14} /> Close Panel
                  </button>
                </div>

                {/* Panel Derecho: Eventos (Scrollable) */}
                <div className="w-full md:w-2/3 p-12 overflow-y-auto">
                  <div className="flex items-center justify-between mb-12">
                    <h3 className="font-serif text-3xl text-white">Execution Log</h3>
                    <button className="font-mono text-[10px] uppercase tracking-widest text-[#4FE3C1] border border-[#4FE3C1]/30 px-4 py-2 rounded-full hover:bg-[#4FE3C1] hover:text-black transition-all">
                      + Inject Event
                    </button>
                  </div>

                  {/* Mock de eventos dentro del día expandido */}
                  <div className="space-y-6">
                    {[1, 2, 3].map(i => (
                      <div key={i} className="group border border-white/5 bg-white/[0.02] p-6 rounded-2xl flex items-center justify-between hover:border-white/20 transition-colors">
                        <div>
                          <span className="font-mono text-[10px] text-[#555]">14:30 · 90M</span>
                          <h4 className="font-sans text-lg text-[#eee] mt-1">Metabolic Flush {i}</h4>
                        </div>
                        <ChevronRight className="text-[#333] group-hover:text-white transition-colors" />
                      </div>
                    ))}
                  </div>
                </div>
              </motion.div>
            </div>
          </>
        )}
      </AnimatePresence>

      {/* --- COMMAND PALETTE (MODAL DE "POCOS CLICS") --- */}
      <AnimatePresence>
        {isQuickLogOpen && (
          <motion.div
            initial={{ opacity: 0, backdropFilter: 'blur(0px)' }}
            animate={{ opacity: 1, backdropFilter: 'blur(12px)' }}
            exit={{ opacity: 0, backdropFilter: 'blur(0px)' }}
            className="fixed inset-0 z-[60] bg-black/60 flex items-center justify-center p-4"
          >
            <motion.div
              initial={{ scale: 0.95, y: 20, opacity: 0 }}
              animate={{ scale: 1, y: 0, opacity: 1 }}
              exit={{ scale: 0.95, y: 20, opacity: 0 }}
              transition={{ type: 'spring', damping: 25, stiffness: 300 }}
              className="w-full max-w-xl bg-[#0d0d0d] border border-white/10 rounded-3xl overflow-hidden shadow-2xl"
            >
              <div className="p-6 border-b border-white/10 flex justify-between items-center bg-[#111]">
                <input
                  type="text"
                  placeholder="Type a meal or sport..."
                  className="bg-transparent border-none outline-none text-xl font-sans text-white w-full placeholder:text-[#444]"
                  autoFocus
                />
                <button onClick={() => setIsQuickLogOpen(false)} className="text-[#555] hover:text-white"><X size={20} /></button>
              </div>
              <div className="p-2">
                <div className="px-4 py-2 font-mono text-[9px] uppercase tracking-widest text-[#555]">Quick Suggestions</div>
                <div className="p-2 hover:bg-white/[0.05] rounded-xl cursor-pointer flex justify-between items-center transition-colors">
                  <div className="flex items-center gap-4">
                    <div className="w-8 h-8 rounded-full bg-[#38BDF8]/10 flex items-center justify-center text-[#38BDF8]"><Dumbbell size={14} /></div>
                    <span className="font-sans text-white">Log Bouldering Session</span>
                  </div>
                  <span className="font-mono text-[10px] text-[#555]">ENTER</span>
                </div>
                <div className="p-2 hover:bg-white/[0.05] rounded-xl cursor-pointer flex justify-between items-center transition-colors">
                  <div className="flex items-center gap-4">
                    <div className="w-8 h-8 rounded-full bg-[#F59E0B]/10 flex items-center justify-center text-[#F59E0B]"><Flame size={14} /></div>
                    <span className="font-sans text-white">Add Tonkotsu Ramen</span>
                  </div>
                  <span className="font-mono text-[10px] text-[#555]">ENTER</span>
                </div>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>

    </div>
  );
}
