                                            </span>
                                            <span className="text-[#626D7C]">Na/K {day.nutrition.ratioNaK}</span>
                                        </div>
                                    </div>
                                </motion.div>
                            );
                        })}
                    </motion.div>

                    {/* --- LAYER 3: SPATIAL DEEP-DIVE INSPECTOR PANEL --- */}
                    <AnimatePresence>
                        {selectedDay && (
