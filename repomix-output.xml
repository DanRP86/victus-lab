@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600&family=Space+Grotesk:wght@300;400;500&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --bg-deep: #030508;
  --text-main: #f0f2f5;
  --accent-cyan: #38bdf8;
  --accent-cyan-glow: rgba(56, 189, 248, 0.4);
  /* Bordes suaves cian-humo en lugar de líneas blancas duras */
  --glass-bg: rgba(9, 15, 25, 0.32);
  --glass-bg-hover: rgba(14, 22, 38, 0.45);
  --glass-border: rgba(56, 189, 248, 0.08);
  --glass-border-hover: rgba(56, 189, 248, 0.28);
  --glass-shadow: 0 14px 35px -10px rgba(0, 0, 0, 0.7);
  --glass-highlight: inset 0 1px 0 rgba(56, 189, 248, 0.08);
}

body {
  background-color: var(--bg-deep);
  color: var(--text-main);
  font-family: 'Manrope', sans-serif;
  overflow: hidden;
  margin: 0;
  height: 100vh;
  width: 100vw;
}

.font-display {
  font-family: 'Space Grotesk', sans-serif;
}

.preserve-3d-scene {
  transform-style: preserve-3d;
  will-change: transform;
}

/* Cristal translúcido suave con borde tenue */
.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  border-radius: 16px;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.35s ease, border-color 0.35s ease;
  position: relative;
}

.glass-panel:hover {
  background: var(--glass-bg-hover);
  border-color: var(--glass-border-hover);
  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.8), 0 0 20px rgba(56, 189, 248, 0.08);
}

.glass-panel-content {
  position: relative;
  z-index: 2;
}

.glass-button {
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(56, 189, 248, 0.08);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.glass-button:hover {
  background: rgba(56, 189, 248, 0.08);
  border-color: rgba(56, 189, 248, 0.35);
  transform: scale(1.05);
}

.chart-line {
  fill: none;
  stroke: var(--accent-cyan);
  stroke-width: 1.5;
  filter: drop-shadow(0 0 6px var(--accent-cyan-glow));
}

.chart-area {
  fill: url(#areaGradient);
}

.data-point {
  fill: var(--bg-deep);
  stroke: var(--accent-cyan);
  stroke-width: 1.5;
  transition: all 0.3s ease;
}

.data-point:hover {
  fill: var(--accent-cyan);
  transform: scale(1.4);
  filter: drop-shadow(0 0 6px var(--accent-cyan));
}

.text-micro {
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.indicator-ring {
  transition: stroke-dashoffset 1.5s cubic-bezier(0.16, 1, 0.3, 1);
}
